# Web VLK Ursus (Next.js export) na LebedaHostingu.
# Úvodní stránka je statická (index.html), ostatní adresy řeší index.php.
# GitHub Pages tento soubor ignoruje, uplatní se jen na Apache.

DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Vždy HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Adresy ze starého WordPressu → odpovídající sekce nového webu (301 = trvale, kvůli SEO)
  RewriteRule ^ursus-2027/?$ /#terminy [R=301,L,NE]
  RewriteRule ^tym-ursu/?$ /#tym [R=301,L,NE]
  RewriteRule ^(o-kurzu|o-nas)/?$ /#o-kurzu [R=301,L,NE]
  RewriteRule ^(prihlaska|prihlasky|prihlaseni)/?$ /#prihlaska [R=301,L,NE]
  RewriteRule ^(kontakt|kontakty)/?$ /#kontakt [R=301,L,NE]
  RewriteRule ^(faq|caste-otazky)/?$ /#faq [R=301,L,NE]
  RewriteRule ^(stezka|cesta-ursu)/?$ /#kapitoly [R=301,L,NE]

  # /tym → tym.html (export Next.js bez koncového lomítka)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # Vše ostatní (staré články WordPressu, neexistující adresy) → index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.php [L]
</IfModule>

<IfModule mod_headers.c>
  # Soubory s hashem v názvu se nemění → dlouhá cache
  <FilesMatch "^.*\.(woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # HTML: Next.js si po načtení stahuje prvních 64 bajtů stránky (Range: bytes=0-63),
  # aby zkontroloval verzi webu. Prohlížeč si ten kousek uložil do cache a při další
  # návštěvě ho zobrazil jako celou stránku → bílá stránka. Proto u HTML Range
  # ignorujeme (vrací se celý soubor) a HTML se do cache neukládá.
  <FilesMatch "\.html$">
    RequestHeader unset Range
    RequestHeader unset If-Range
    Header unset Accept-Ranges
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain text/xml application/manifest+json
</IfModule>
